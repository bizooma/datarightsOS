{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_scan_purge",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "purge_old_scans": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "purgeOldScans",
            "args": {
              "scheduled": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Purge scans older than 90 days"
          }
        }
      }
    ]
  },
  "description": "Deletes website scanner records older than 90 days, every night at 3am UTC.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Nightly Scan Purge"
}
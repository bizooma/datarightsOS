{
  "name": "Request status changed \u2192 outbound webhook",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"request_status\") != null) and (.trigger.data.request_status == \"fulfilled\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DataRightsRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "request_status_changed_outbound_webhook",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onRequestStatusChanged",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
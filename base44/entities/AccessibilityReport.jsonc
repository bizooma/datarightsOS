{
  "name": "AccessibilityReport",
  "type": "object",
  "properties": {
    "organization": {
      "type": "string",
      "description": "Reference to Organization (denormalized from the site at intake, for tenant scoping)"
    },
    "site": {
      "type": "string",
      "description": "Reference to Site"
    },
    "page_url": {
      "type": "string",
      "description": "URL of the page with the accessibility issue"
    },
    "description": {
      "type": "string",
      "description": "Description of the accessibility issue"
    },
    "reporter_email": {
      "type": "string",
      "description": "Email of the person reporting the issue"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewing",
        "resolved"
      ],
      "default": "new",
      "description": "Current status of the report"
    },
    "assigned_to": {
      "type": "string",
      "description": "Reference to the User assigned to investigate this report"
    }
  },
  "required": [
    "site",
    "page_url",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "bizooma_superadmin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "bizooma_superadmin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "bizooma_superadmin"
          }
        }
      ]
    }
  }
}
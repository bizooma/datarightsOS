{
  "name": "ConsentRecord",
  "type": "object",
  "properties": {
    "organization": {
      "type": "string",
      "description": "Reference to Organization (denormalized from the site at intake, for tenant scoping)"
    },
    "site": {
      "type": "string",
      "description": "Reference to Site"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or note about the consent record"
    },
    "visitor_id": {
      "type": "string",
      "description": "Anonymous visitor identifier from the widget"
    },
    "action": {
      "type": "string",
      "enum": [
        "accept_all",
        "reject_all",
        "save_choices",
        "gpc_optout"
      ],
      "description": "The consent action taken"
    },
    "necessary": {
      "type": "boolean",
      "default": true,
      "description": "Necessary cookies accepted"
    },
    "functional": {
      "type": "boolean",
      "description": "Functional cookies accepted"
    },
    "analytics": {
      "type": "boolean",
      "description": "Analytics cookies accepted"
    },
    "advertising": {
      "type": "boolean",
      "description": "Advertising cookies accepted"
    },
    "gpc_detected": {
      "type": "boolean",
      "description": "Whether Global Privacy Control was detected"
    },
    "region_state": {
      "type": "string",
      "description": "Inferred US state of the visitor"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent string"
    },
    "policy_version": {
      "type": "string",
      "description": "Privacy policy version at time of consent"
    },
    "consent_receipt_id": {
      "type": "string",
      "description": "Unique consent receipt identifier (auto-generated)"
    },
    "enforcement_applied": {
      "type": "boolean",
      "default": false,
      "description": "Whether the widget actively enforced the decision client-side (blocked tags, cleared cookies, sent consent-mode signals), not just recorded it."
    },
    "enforced_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categories actually blocked/denied during enforcement, e.g. ['functional','analytics','advertising']."
    },
    "signals_sent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Enforcement signals emitted, e.g. ['consent_mode:denied','gpc:honored','do_not_sell:set']."
    },
    "unmanaged_detected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Non-necessary trackers/cookies present but NOT wired through the widget \u2014 detected but not blocked."
    },
    "verification_passed": {
      "type": "boolean",
      "description": "Self-verification outcome: cookies in denied categories were confirmed absent/cleared and gated tags did not execute."
    },
    "decision_persisted": {
      "type": "boolean",
      "default": false,
      "description": "Whether this record reflects a prior decision re-applied from storage on a return visit (no re-prompt)."
    }
  },
  "required": [
    "site",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
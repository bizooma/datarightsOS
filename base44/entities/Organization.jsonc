{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization name"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of the organization"
    },
    "business_name": {
      "type": "string",
      "description": "Public-facing business name used as the from-name on requester emails. Falls back to organization name."
    },
    "privacy_contact_email": {
      "type": "string",
      "description": "Reply-to address for requester emails and the contact shown to requesters. Requester notifications are not sent if this is empty."
    },
    "ack_email_subject": {
      "type": "string",
      "description": "Editable subject line for the acknowledgment email sent to requesters."
    },
    "ack_email_body": {
      "type": "string",
      "description": "Editable body for the acknowledgment email sent to requesters."
    },
    "completion_email_subject": {
      "type": "string",
      "description": "Editable subject line for the completion email sent to requesters."
    },
    "completion_email_body": {
      "type": "string",
      "description": "Editable body for the completion email sent to requesters."
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York",
      "description": "IANA timezone (e.g. America/Chicago) used to display deadlines, key dates, and audit timestamps in the dashboard. Stored dates remain UTC; this only affects presentation."
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "free",
        "notice",
        "core",
        "proof",
        "agency"
      ],
      "default": "trial",
      "description": "Subscription plan. 'free' is the permanent free plan an expired trial rolls into (cookie consent only)."
    },
    "trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the trial started (set on org creation)"
    },
    "trial_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the 2-days-left trial reminder email was sent. Guards against duplicate sends."
    },
    "white_label_product_name": {
      "type": "string",
      "default": "Privacy & Data Rights Center",
      "description": "White-label product name shown in the widget"
    },
    "brand_logo_url": {
      "type": "string",
      "description": "URL to the organization's brand logo"
    },
    "brand_primary_color": {
      "type": "string",
      "default": "#0d7d74",
      "description": "Primary brand color for the widget"
    },
    "webhook_url": {
      "type": "string",
      "description": "Outbound webhook HTTPS endpoint that receives new data-rights request events."
    },
    "webhook_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether outbound webhook delivery is enabled."
    },
    "webhook_secret": {
      "type": "string",
      "description": "HMAC-SHA256 signing secret for outbound webhook payloads."
    },
    "webhook_last_status": {
      "type": "object",
      "description": "Result of the most recent outbound webhook delivery attempt.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "http_code": {
          "type": "number"
        },
        "message": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "canceled"
      ],
      "default": "active",
      "description": "Current billing status"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for this organization"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID for this organization"
    },
    "referral_source": {
      "type": "string",
      "description": "Partner referral code captured from the ?ref= query parameter at signup (first-touch attribution). Permanent once set; not editable by the subscriber. Used for commission runs and passed to Stripe metadata."
    },
    "referral_captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the referral_source was captured and attributed to this organization at signup."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.data.organization}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
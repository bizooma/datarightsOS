{
  "name": "Scan",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "description": "Normalized URL that was scanned"
    },
    "domain": {
      "type": "string",
      "description": "Hostname of the scanned URL \u2014 used for the 1-scan-per-domain-per-hour cache"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "complete",
        "failed",
        "blocked"
      ],
      "default": "running",
      "description": "Scan lifecycle. failed = Browserless errored/timed out and NO findings are reported. blocked = the page we loaded was a bot challenge, block page, or CDN error rather than the site, so NO findings are reported \u2014 analyzing it would describe the challenge page instead of the business. Only 'complete' is ever served from the domain cache."
    },
    "block_reason": {
      "type": "string",
      "description": "WHICH block signal fired, in internal terms (e.g. 'The site returned HTTP 403 for the page itself.'). Distinct from `error`, which holds the visitor-facing BLOCKED_MESSAGE and is identical for every blocked scan. Stored because a wrongly-blocked scan is otherwise unclassifiable after the fact: the detector's reason used to go only to logs, which age out, so auditing three historical blocked scans meant re-fetching the live domains and inferring which rule had fired \u2014 and one of them (a site running Cloudflare Turnstile on its contact form) turned out to be a false positive that had been silently returning zero findings. Set only when status='blocked'. Internal diagnostics, never shown to visitors."
    },
    "requester_ip_hash": {
      "type": "string",
      "description": "Salted SHA-256 of the requester IP, used only for rate limiting (3/hr, 10/day per IP). Raw IP is never stored."
    },
    "processing_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when processScan claims the record \u2014 guards against double-processing (each scan is two paid browser sessions)."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the scan reached a terminal status"
    },
    "error": {
      "type": "string",
      "description": "Failure reason when status=failed, or the visitor-facing explanation when status=blocked"
    },
    "gpc_pass_failed": {
      "type": "boolean",
      "default": false,
      "description": "True when the second (Sec-GPC) load failed \u2014 the GPC comparison check is COULD NOT DETERMINE, other checks still report."
    },
    "findings": {
      "type": "object",
      "additionalProperties": true,
      "description": "Group A check results. findings.checks.<key> = {status: found|not_found|could_not_determine, observation, details[]}. Observations only, never verdicts."
    },
    "third_party_domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unique third-party request hostnames observed on the first (no-consent) load"
    },
    "pdf_url": {
      "type": "string",
      "description": "Cached PDF of this report, rendered once by Browserless on the first download or email and reused afterwards. A report's findings never change once complete, so the file is generated lazily and cached forever \u2014 we pay for one render per report, not one per download."
    },
    "pdf_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cached PDF was rendered."
    },
    "report_emails": {
      "type": "array",
      "description": "Addresses this report was emailed to, in order. Capped at 2 sends per report and never the same address twice. Nothing here is synced to a marketing platform.",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time"
          },
          "opted_in": {
            "type": "boolean",
            "default": false,
            "description": "Whether the visitor checked the optional updates box. Stored only."
          }
        }
      }
    }
  },
  "required": [
    "url",
    "domain"
  ],
  "rls": {
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
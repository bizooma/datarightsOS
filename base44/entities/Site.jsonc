{
  "name": "Site",
  "type": "object",
  "properties": {
    "organization": {
      "type": "string",
      "description": "Reference to Organization"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of the site"
    },
    "domain": {
      "type": "string",
      "description": "Website domain, e.g. clientfirm.com"
    },
    "site_key": {
      "type": "string",
      "description": "Public unique key the widget uses (auto-generated)"
    },
    "install_status": {
      "type": "string",
      "enum": [
        "pending",
        "active"
      ],
      "default": "pending",
      "description": "Widget installation status"
    },
    "brand_product_name": {
      "type": "string",
      "description": "Site-specific white-label product name shown in the widget. Falls back to organization name if empty."
    },
    "brand_logo_url": {
      "type": "string",
      "description": "Site-specific brand logo URL shown in the widget. Falls back to organization logo if empty."
    },
    "brand_primary_color": {
      "type": "string",
      "description": "Site-specific primary brand color for the widget. Falls back to organization color if empty."
    },
    "business_name": {
      "type": "string",
      "description": "Site-specific from-name on requester emails. Falls back to the organization's business name, then organization name."
    },
    "privacy_contact_email": {
      "type": "string",
      "description": "Site-specific reply-to address and contact shown to requesters. Falls back to the organization's privacy contact email. Requester emails are not sent if neither is set."
    },
    "ack_email_subject": {
      "type": "string",
      "description": "Site-specific acknowledgment email subject. Falls back to the organization's, then the default template."
    },
    "ack_email_body": {
      "type": "string",
      "description": "Site-specific acknowledgment email body. Falls back to the organization's, then the default template."
    },
    "completion_email_subject": {
      "type": "string",
      "description": "Site-specific completion email subject. Falls back to the organization's, then the default template."
    },
    "completion_email_body": {
      "type": "string",
      "description": "Site-specific completion email body. Falls back to the organization's, then the default template."
    },
    "hide_branding": {
      "type": "boolean",
      "default": false,
      "description": "Remove the 'Powered by DataRightsOS' widget badge. Only honored on the Agency (white-label) plan."
    },
    "enabled_drawers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cookies",
          "privacy_rights",
          "accessibility",
          "ai_disclosure"
        ]
      },
      "default": [
        "cookies",
        "privacy_rights"
      ],
      "description": "Which drawers are enabled in the widget"
    },
    "widget_position": {
      "type": "string",
      "enum": [
        "bottom-right",
        "bottom-left",
        "top-right",
        "top-left"
      ],
      "default": "bottom-right",
      "description": "Corner position of the widget launcher button"
    },
    "widget_layout": {
      "type": "string",
      "enum": [
        "floating",
        "bar"
      ],
      "default": "floating",
      "description": "How the first-visit consent moment appears on desktop/tablet: 'floating' (a card panel, current behavior) or 'bar' (a horizontal bar fixed across the bottom of the viewport). Presentation only \u2014 consent logic, GPC enforcement, and everything downstream are identical in both layouts. On mobile both layouts always render the consent moment as the bottom bar. After a choice is recorded, both layouts collapse to the same small pill launcher."
    },
    "launcher_position": {
      "type": "string",
      "enum": [
        "bottom-right",
        "bottom-left",
        "bottom-center"
      ],
      "default": "bottom-right",
      "description": "Corner/position of the MINIMIZED launcher pill. Independent of widget_position (which affects the floating panel). Lets subscribers place the launcher clear of host-site UI."
    },
    "launcher_offset_bottom": {
      "type": "number",
      "default": 0,
      "description": "Distance in px to lift the minimized launcher (and the bar-layout consent bar) up from the bottom of the viewport, so it clears a host site's fixed bottom navigation. Applied on all screen sizes. iOS PWA safe-area inset is always added on top of this automatically. Default 0."
    },
    "launcher_offset_bottom_mobile": {
      "type": "number",
      "description": "Optional mobile-only override for launcher_offset_bottom (px). Most sites only have a bottom nav on mobile. If unset (null), mobile inherits launcher_offset_bottom."
    },
    "widget_theme": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark",
      "description": "Color theme of the widget launcher and panel"
    },
    "default_open": {
      "type": "boolean",
      "default": true,
      "description": "Whether the widget panel opens automatically when a visitor lands on the site. When false, only the launcher button is shown until the visitor clicks it. On mobile the panel never auto-opens regardless."
    },
    "honor_gpc": {
      "type": "boolean",
      "default": true,
      "description": "Whether to honor Global Privacy Control signals"
    },
    "intro_video_url": {
      "type": "string",
      "description": "URL to an introductory video"
    },
    "accessibility_statement_url": {
      "type": "string",
      "description": "URL to accessibility statement"
    },
    "barrier_report_email": {
      "type": "string",
      "description": "Email for accessibility barrier reports"
    },
    "privacy_policy_url": {
      "type": "string",
      "description": "URL to the privacy policy"
    },
    "policy_version": {
      "type": "string",
      "default": "1.0",
      "description": "Current privacy policy version"
    },
    "intake_rate_limit_per_hour": {
      "type": "number",
      "default": 100,
      "description": "Max privacy rights requests accepted from this site's public widget per rolling hour before the intake endpoint returns a graceful 'too many requests' response that points the consumer to the privacy contact email. Protects our sending-domain deliverability from abuse while allowing legitimate surges (e.g. after a breach notice). A per-email cap of 3/hour is enforced separately and is not configurable."
    }
  },
  "required": [
    "organization",
    "domain"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Site",
  "type": "object",
  "properties": {
    "organization": {
      "type": "string",
      "description": "Reference to Organization"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of the site"
    },
    "domain": {
      "type": "string",
      "description": "Website domain, e.g. clientfirm.com"
    },
    "site_key": {
      "type": "string",
      "description": "Public unique key the widget uses (auto-generated)"
    },
    "slug": {
      "type": "string",
      "description": "IMMUTABLE public identifier used in this site's statement URLs (/functions/statement?site=<slug>). Derived once from the domain at creation (clientfirm.com -> clientfirm-com), with a numeric suffix on collision (clientfirm-com-2). NEVER regenerate or follow a domain edit: published statement links, footer snippets, search-engine indexes, and scanner records all point at this value, so changing it silently breaks every one of them. Assigned server-side by ensureSiteSlug, which needs a global uniqueness check no single tenant can perform. site_key remains a valid lookup for any statement URL already in the wild."
    },
    "inject_footer_links": {
      "type": "boolean",
      "description": "Whether the widget injects plain anchor links to this site's four statement URLs into the host page footer. NULL (unset) means 'use the plan default', which is ON for every plan EXCEPT Agency \u2014 Agency pays to remove our branding, and an injected datarightsos.com link in their client's footer would undo that. Resolved per-request in widgetConfig, never read raw by the widget. Injected links are visible to crawlers that execute JavaScript but not to those that don't, which is why Widget Studio also offers a static footer snippet."
    },
    "inject_privacy_choices_link": {
      "type": "boolean",
      "description": "Whether the widget injects a plain 'Your Privacy Choices' anchor (pointing at /functions/privacyChoices?site=<slug>) into the host page footer. NULL (unset) means 'use the plan default', which is ON for EVERY plan INCLUDING Agency. That is a deliberate inconsistency with inject_footer_links, which defaults OFF for Agency: hosted statement content is optional, but a reachable opt-out mechanism is not, so the white-label concern is answered by the domain-rewrite instructions rather than by withholding the link. An explicit true/false from the subscriber always wins."
    },
    "install_status": {
      "type": "string",
      "enum": [
        "pending",
        "active"
      ],
      "default": "pending",
      "description": "Widget installation status"
    },
    "brand_product_name": {
      "type": "string",
      "description": "Site-specific white-label product name shown in the widget. Falls back to organization name if empty."
    },
    "brand_logo_url": {
      "type": "string",
      "description": "Site-specific brand logo URL shown in the widget. Falls back to organization logo if empty."
    },
    "brand_primary_color": {
      "type": "string",
      "description": "Site-specific primary brand color for the widget. Falls back to organization color if empty."
    },
    "business_name": {
      "type": "string",
      "description": "Site-specific from-name on requester emails. Falls back to the organization's business name, then organization name."
    },
    "privacy_contact_email": {
      "type": "string",
      "description": "Site-specific reply-to address and contact shown to requesters. Falls back to the organization's privacy contact email. Requester emails are not sent if neither is set."
    },
    "ack_email_subject": {
      "type": "string",
      "description": "Site-specific acknowledgment email subject. Falls back to the organization's, then the default template."
    },
    "ack_email_body": {
      "type": "string",
      "description": "Site-specific acknowledgment email body. Falls back to the organization's, then the default template."
    },
    "completion_email_subject": {
      "type": "string",
      "description": "Site-specific completion email subject. Falls back to the organization's, then the default template."
    },
    "completion_email_body": {
      "type": "string",
      "description": "Site-specific completion email body. Falls back to the organization's, then the default template."
    },
    "hide_branding": {
      "type": "boolean",
      "default": false,
      "description": "Remove the 'Powered by DataRightsOS' widget badge. Only honored on the Agency (white-label) plan."
    },
    "enabled_drawers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cookies",
          "privacy_rights",
          "accessibility",
          "ai_disclosure"
        ]
      },
      "default": [
        "cookies",
        "privacy_rights"
      ],
      "description": "Which drawers are enabled in the widget"
    },
    "widget_position": {
      "type": "string",
      "enum": [
        "bottom-right",
        "bottom-left",
        "bottom-center",
        "top-right",
        "top-left"
      ],
      "default": "bottom-right",
      "description": "Position of the expanded floating panel. bottom-center centers it horizontally (left:50% + translateX(-50%)); in bar layout the expanded panel is always full-width so this only affects the floating layout."
    },
    "launcher_position": {
      "type": "string",
      "enum": [
        "bottom-right",
        "bottom-left",
        "bottom-center"
      ],
      "default": "bottom-right",
      "description": "Corner/position of the MINIMIZED launcher pill. Independent of widget_position (which affects the floating panel). Lets subscribers place the launcher clear of host-site UI."
    },
    "launcher_style": {
      "type": "string",
      "enum": [
        "pill",
        "custom"
      ],
      "default": "pill",
      "description": "Launcher appearance: 'pill' (standard, default) or 'custom' (subscriber-uploaded image + REQUIRED text label). Custom is honored only on Core+ plans \u2014 enforced server-side in widgetConfig; Free/Notice always render the standard pill."
    },
    "launcher_image_url": {
      "type": "string",
      "description": "Uploaded launcher image URL (PNG/JPG/SVG/WebP, max 500KB, uploaded via the platform \u2014 never an external hotlink). Rendered at 44px tall, width auto, max 120px, aspect ratio preserved, alt='' (decorative \u2014 the adjacent text label carries meaning)."
    },
    "launcher_label": {
      "type": "string",
      "description": "REQUIRED text label rendered beside the custom launcher image. Editable wording but can never be blank \u2014 an unlabeled launcher makes the privacy path unfindable. Server falls back to 'Privacy & Data Rights' if empty."
    },
    "launcher_offset_bottom": {
      "type": "number",
      "default": 0,
      "description": "Distance in px to lift the minimized launcher (and the bar-layout consent bar) up from the bottom of the viewport, so it clears a host site's fixed bottom navigation. Applied on all screen sizes. iOS PWA safe-area inset is always added on top of this automatically. Default 0."
    },
    "launcher_offset_bottom_mobile": {
      "type": "number",
      "description": "Optional mobile-only override for launcher_offset_bottom (px). Most sites only have a bottom nav on mobile. If unset (null), mobile inherits launcher_offset_bottom."
    },
    "widget_layout": {
      "type": "string",
      "enum": [
        "floating",
        "bar"
      ],
      "default": "floating",
      "description": "How the first-visit consent moment appears on desktop/tablet: 'floating' (a card panel, current behavior) or 'bar' (a horizontal bar fixed across the bottom of the viewport). Presentation only \u2014 consent logic, GPC enforcement, and everything downstream are identical in both layouts. On mobile both layouts always render the consent moment as the bottom bar. After a choice is recorded, both layouts collapse to the same small pill launcher."
    },
    "widget_theme": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark",
      "description": "Color theme of the widget launcher and panel"
    },
    "default_open": {
      "type": "boolean",
      "default": true,
      "description": "Whether the widget panel opens automatically when a visitor lands on the site. When false, only the launcher button is shown until the visitor clicks it. On mobile the panel never auto-opens regardless."
    },
    "honor_gpc": {
      "type": "boolean",
      "default": true,
      "description": "Whether to honor Global Privacy Control signals"
    },
    "intro_video_url": {
      "type": "string",
      "description": "URL to an introductory video"
    },
    "accessibility_statement_url": {
      "type": "string",
      "description": "URL to accessibility statement"
    },
    "barrier_report_email": {
      "type": "string",
      "description": "Email for accessibility barrier reports"
    },
    "privacy_policy_url": {
      "type": "string",
      "description": "URL to the privacy policy"
    },
    "policy_version": {
      "type": "string",
      "default": "1.0",
      "description": "Current privacy policy version"
    },
    "intake_rate_limit_per_hour": {
      "type": "number",
      "default": 100,
      "description": "Max privacy rights requests accepted from this site's public widget per rolling hour before the intake endpoint returns a graceful 'too many requests' response that points the consumer to the privacy contact email. Protects our sending-domain deliverability from abuse while allowing legitimate surges (e.g. after a breach notice). A per-email cap of 3/hour is enforced separately and is not configurable."
    }
  },
  "required": [
    "organization",
    "domain"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
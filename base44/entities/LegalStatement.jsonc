{
  "name": "LegalStatement",
  "type": "object",
  "properties": {
    "site": {
      "type": "string",
      "description": "Reference to Site"
    },
    "organization": {
      "type": "string",
      "description": "Reference to Organization"
    },
    "statement_type": {
      "type": "string",
      "enum": [
        "privacy_policy",
        "cookie_policy",
        "accessibility_statement",
        "ai_use_statement"
      ],
      "description": "Type of legal statement"
    },
    "title": {
      "type": "string",
      "description": "Display title for this statement (English)"
    },
    "body": {
      "type": "string",
      "description": "Full HTML/rich-text body of the statement (English)"
    },
    "title_es": {
      "type": "string",
      "description": "Spanish display title for this statement (optional)"
    },
    "body_es": {
      "type": "string",
      "description": "Spanish HTML/rich-text body of the statement (optional)"
    },
    "version": {
      "type": "string",
      "default": "1.0",
      "description": "Version of this statement"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the currently active version"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date this version became effective"
    }
  },
  "required": [
    "site",
    "organization",
    "statement_type",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.organization": "{{user.data.organization}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}